package com.example.aum;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.widget.Button;
import android.widget.ImageView;
import android.widget.TextView;
import android.widget.Toast;

import androidx.activity.result.ActivityResultLauncher;
import androidx.activity.result.contract.ActivityResultContracts;
import androidx.appcompat.app.AppCompatActivity;

public class ScannCinActivity extends AppCompatActivity {

    ActivityResultLauncher<Intent> launcher;

    ImageView imgPreview;
    TextView txtResult;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_scann_cin);

        Button btnAttach = findViewById(R.id.btnAttach);
        Button btnScan = findViewById(R.id.btnScanCin);
        Button next = findViewById(R.id.btnValider);

        imgPreview = findViewById(R.id.imgPreview);
        txtResult = findViewById(R.id.txtResult);

        next.setVisibility(Button.GONE);

        launcher = registerForActivityResult(
                new ActivityResultContracts.StartActivityForResult(),
                result -> {

                    if (result.getResultCode() == RESULT_OK && result.getData() != null) {

                        Uri uri = result.getData().getData();

                        DossierData.cinImage = uri.toString();

                        // 🔥 FIX IMAGE NOT SHOWING
                        imgPreview.setImageURI(uri);

                        txtResult.setText("CIN SELECTED ✔");
                        next.setVisibility(Button.VISIBLE);
                    }
                }
        );

        btnAttach.setOnClickListener(v -> {

            Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
            i.setType("image/*");
            i.addCategory(Intent.CATEGORY_OPENABLE);

            launcher.launch(i);
        });

        btnScan.setOnClickListener(v -> {
            Toast.makeText(this, "Scanner option (future)", Toast.LENGTH_SHORT).show();
        });

        next.setOnClickListener(v ->
                startActivity(new Intent(this, PaiementActivity.class))
        );
    }
}


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- SCROLLABLE CONTENT ONLY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanner CIN"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"/>

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="320dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="#E2E8F0"
                android:layout_marginBottom="10dp"/>

            <!-- RESULT LONG TEXT SAFE -->
            <TextView
                android:id="@+id/txtResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="Result..."
                android:textSize="16sp"/>
        </LinearLayout>

    </ScrollView>

    <!-- FIXED BUTTON AREA (IMPORTANT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnScanCin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SCAN CIN"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnAttach"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ATTACH FILE"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:backgroundTint="#6366F1"/>

        <Button
            android:id="@+id/btnValider"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VALIDER"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:backgroundTint="#16A34A"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
