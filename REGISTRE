package com.example.aum;

import android.content.Intent;
import android.os.Bundle;
import android.view.View;
import android.widget.*;

import androidx.appcompat.app.AppCompatActivity;

import com.android.volley.Request;
import com.android.volley.toolbox.StringRequest;
import com.android.volley.toolbox.Volley;

import java.util.HashMap;
import java.util.Map;

public class RegisterActivity extends AppCompatActivity {

    EditText etEmail, etCode, etPassword;
    Button btnSend, btnVerify;

    String emailGlobal = "";
    String serverCode = "";

    String baseUrl = "http://172.20.10.2/myapi/";

    boolean isChecking = false;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_register);

        etEmail = findViewById(R.id.etEmail);
        etCode = findViewById(R.id.etCode);
        etPassword = findViewById(R.id.etPassword);

        btnSend = findViewById(R.id.btnSend);
        btnVerify = findViewById(R.id.btnVerify);

        etCode.setVisibility(View.GONE);
        etPassword.setVisibility(View.GONE);
        btnVerify.setVisibility(View.GONE);

        // 📧 SEND EMAIL
        btnSend.setOnClickListener(v -> {

            String email = etEmail.getText().toString().trim();

            if (email.isEmpty()) {
                Toast.makeText(this, "Enter email", Toast.LENGTH_SHORT).show();
                return;
            }

            emailGlobal = email;
            sendEmail(email);

            // 🔥 start checking after send
            startSmartCheck();
        });

        // 🔐 VERIFY CODE
        btnVerify.setOnClickListener(v -> {

            if (etCode.getText().toString().equals(serverCode)) {

                Toast.makeText(this, "SUCCESS ✔", Toast.LENGTH_LONG).show();
                startActivity(new Intent(this, InfoActivity.class));

            } else {
                Toast.makeText(this, "WRONG CODE ❌", Toast.LENGTH_SHORT).show();
            }
        });
    }

    // 📧 SEND EMAIL
    private void sendEmail(String email) {

        String url = baseUrl + "send_mail.php";

        StringRequest request = new StringRequest(
                Request.Method.POST,
                url,
                response -> {

                    if (response.trim().equals("success")) {
                        Toast.makeText(this, "Check Gmail ✔", Toast.LENGTH_SHORT).show();
                    }
                },
                error -> Toast.makeText(this, "ERROR", Toast.LENGTH_SHORT).show()
        ) {
            @Override
            protected Map<String, String> getParams() {
                Map<String, String> map = new HashMap<>();
                map.put("email", email);
                return map;
            }
        };

        Volley.newRequestQueue(this).add(request);
    }

    // 🔥 SMART CHECK AFTER ACCEPT
    private void startSmartCheck() {

        if (isChecking) return;

        isChecking = true;

        new Thread(() -> {

            for (int i = 0; i < 15; i++) { // ~30 seconds max

                runOnUiThread(this::checkVerifiedOnce);

                try {
                    Thread.sleep(2000);
                } catch (Exception e) {}

            }

            isChecking = false;

        }).start();
    }

    // 🔍 CHECK ONCE
    private void checkVerifiedOnce() {

        String url = baseUrl + "check_verified.php?email=" + emailGlobal;

        StringRequest request = new StringRequest(
                Request.Method.GET,
                url,
                response -> {

                    response = response.trim();

                    if (response.startsWith("verified:")) {

                        serverCode = response.split(":")[1];

                        runOnUiThread(() -> {

                            Toast.makeText(this, "Email Accepted ✔", Toast.LENGTH_SHORT).show();

                            etCode.setVisibility(View.VISIBLE);
                            etPassword.setVisibility(View.VISIBLE);
                            btnVerify.setVisibility(View.VISIBLE);
                        });

                        isChecking = false; // stop immediately
                    }
                },
                error -> {}
        );

        Volley.newRequestQueue(this).add(request);
    }
}




<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC">

    <!-- TOP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#81C9FA"
        android:orientation="vertical"/>

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="25dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/logo"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email verification required"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter email"
            android:paddingLeft="20dp"
            android:background="#F5F5F5"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="15dp"/>

        <!-- SEND -->
        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Send Code"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"/>

        <!-- INFO -->
        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check Gmail and click ACCEPT"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="15dp"
            android:visibility="gone"/>

        <!-- CODE -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Verification Code"
            android:paddingLeft="20dp"
            android:background="#F5F5F5"
            android:layout_marginTop="15dp"
            android:visibility="gone"/>

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingLeft="20dp"
            android:background="#F5F5F5"
            android:layout_marginTop="15dp"
            android:visibility="gone"/>

        <!-- VERIFY -->
        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VALIDER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#7209B7"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

    </LinearLayout>

</RelativeLayout>
