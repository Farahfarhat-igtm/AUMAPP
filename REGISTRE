package com.example.aum;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.widget.Button;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

import java.io.ByteArrayOutputStream;
import java.io.InputStream;

import okhttp3.*;

public class PaiementActivity extends AppCompatActivity {

    Button btnValider, btnOpenPayment;

    OkHttpClient client = new OkHttpClient();

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_paiement);

        btnValider = findViewById(R.id.btnValider);
        btnOpenPayment = findViewById(R.id.btnOpenPayment);

        btnOpenPayment.setOnClickListener(v ->
                startActivity(new Intent(this, FakePaymentActivity.class))
        );

        btnValider.setOnClickListener(v -> upload());
    }

    private void upload() {

        new Thread(() -> {

            try {

                MultipartBody.Builder builder = new MultipartBody.Builder()
                        .setType(MultipartBody.FORM);

                // TEXT (MATCH DB EXACT)
                builder.addFormDataPart("cin", DossierData.cin);
                builder.addFormDataPart("nom", DossierData.nom);
                builder.addFormDataPart("prenom", DossierData.prenom);
                builder.addFormDataPart("telephone", DossierData.telephone);
                builder.addFormDataPart("civilite", DossierData.civilite);

                builder.addFormDataPart("numero_dossier", DossierData.numero_dossier);
                builder.addFormDataPart("surface_terrain", DossierData.surface_terrain);
                builder.addFormDataPart("adresse_localisation", DossierData.adresse_localisation);
                builder.addFormDataPart("latitude", DossierData.latitude);
                builder.addFormDataPart("longitude", DossierData.longitude);

                // FILES (MATCH MYSQL EXACT)

                builder.addFormDataPart("pdf_demande", "pdf1.pdf",
                        RequestBody.create(
                                FileUtil.getBytes(this, Uri.parse(DossierData.pdf1)),
                                MediaType.parse("application/pdf")
                        )
                );

                builder.addFormDataPart("pdf_autre", "pdf2.pdf",
                        RequestBody.create(
                                FileUtil.getBytes(this, Uri.parse(DossierData.pdf2)),
                                MediaType.parse("application/pdf")
                        )
                );

                builder.addFormDataPart("scan_cin", "cin.jpg",
                        RequestBody.create(
                                FileUtil.getBytes(this, Uri.parse(DossierData.cinImage)),
                                MediaType.parse("image/jpeg")
                        )
                );

                Request request = new Request.Builder()
                        .url("http://10.0.2.2/aum_api/upload_dossier.php")
                        .post(builder.build())
                        .build();

                Response response = client.newCall(request).execute();

                String result = response.body() != null ? response.body().string() : "NO RESPONSE";

                runOnUiThread(() ->
                        Toast.makeText(this, result, Toast.LENGTH_LONG).show()
                );

            } catch (Exception e) {

                runOnUiThread(() ->
                        Toast.makeText(this, "ERROR: " + e.getMessage(), Toast.LENGTH_LONG).show()
                );
            }

        }).start();
    }
}  
