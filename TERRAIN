package com.example.aum;

import android.content.Intent;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

public class TerrainActivity extends AppCompatActivity {

    EditText etTitre, etCode, etSurface;
    Button btnMap, btnNext;
    TextView txtLocation;

    String latitude = "";
    String longitude = "";

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_terrain);

        etTitre = findViewById(R.id.etTitre);
        etCode = findViewById(R.id.etCode);
        etSurface = findViewById(R.id.etSurface);
        btnMap = findViewById(R.id.btnMap);
        btnNext = findViewById(R.id.btnValider);
        txtLocation = findViewById(R.id.txtLocation);

        // ================= OPEN MAP =================
        btnMap.setOnClickListener(v -> {
            Intent intent = new Intent(this, MapActivity.class);
            startActivityForResult(intent, 1);
        });

        // ================= NEXT =================
        btnNext.setOnClickListener(v -> {

            if (etTitre.getText().toString().isEmpty()
                    || etCode.getText().toString().isEmpty()
                    || etSurface.getText().toString().isEmpty()
                    || latitude.isEmpty()
                    || longitude.isEmpty()) {

                Toast.makeText(this,
                        "Fill all fields + select location",
                        Toast.LENGTH_SHORT).show();
                return;
            }

            // ================= SAVE GLOBAL =================
            DossierData.numero_dossier = etCode.getText().toString().trim();
            DossierData.surface_terrain = etSurface.getText().toString().trim();
            DossierData.adresse_localisation = etTitre.getText().toString().trim();
            DossierData.latitude = latitude;
            DossierData.longitude = longitude;

            Toast.makeText(this,
                    "Terrain saved ✔",
                    Toast.LENGTH_SHORT).show();

            startActivity(new Intent(this, ScannerActivity.class));
        });
    }

    // ================= RECEIVE MAP RESULT =================
    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);

        if (requestCode == 1 && resultCode == RESULT_OK && data != null) {

            double lat = data.getDoubleExtra("lat", 0);
            double lng = data.getDoubleExtra("lng", 0);

            if (lat == 0 || lng == 0) {
                Toast.makeText(this,
                        "Location not received",
                        Toast.LENGTH_SHORT).show();
                return;
            }

            latitude = String.valueOf(lat);
            longitude = String.valueOf(lng);

            txtLocation.setText(
                    "📍 Selected Location:\nLat: " + latitude +
                            "\nLng: " + longitude
            );
        }
    }
}
