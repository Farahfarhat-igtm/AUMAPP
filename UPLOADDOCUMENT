package com.example.aum;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.widget.Button;
import android.widget.TextView;

import androidx.activity.result.ActivityResultLauncher;
import androidx.activity.result.contract.ActivityResultContracts;
import androidx.appcompat.app.AppCompatActivity;

public class UploadDocumentActivity extends AppCompatActivity {

    ActivityResultLauncher<Intent> launcher;
    TextView txtFile;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_upload_document);

        Button btn = findViewById(R.id.btnImport);
        Button next = findViewById(R.id.btnValider);
        txtFile = findViewById(R.id.txtFile);

        next.setVisibility(Button.GONE);

        launcher = registerForActivityResult(
                new ActivityResultContracts.StartActivityForResult(),
                result -> {

                    if (result.getResultCode() == RESULT_OK && result.getData() != null) {

                        Uri uri = result.getData().getData();

                        DossierData.pdf2 = uri.toString();

                        txtFile.setText("PDF 2 SELECTED ✔");
                        next.setVisibility(Button.VISIBLE);
                    }
                }
        );

        btn.setOnClickListener(v -> {

            Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
            i.setType("application/pdf");
            i.addCategory(Intent.CATEGORY_OPENABLE);

            launcher.launch(i);
        });

        next.setOnClickListener(v ->
                startActivity(new Intent(this, ScannCinActivity.class))
        );
    }
}


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#EAF7FF">

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#6D7CFF"
        android:padding="25dp"
        android:gravity="center_horizontal">

        <!-- ICON -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@android:drawable/ic_menu_upload"
            android:layout_marginTop="10dp"
            app:tint="#FFFFFF" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importer fichier"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <!-- FILE BOX -->
        <LinearLayout
            android:id="@+id/boxFile"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="25dp"
            android:background="#8F9BFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="15dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/txtFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliquer pour choisir fichier (PDF / IMAGE)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- IMPORT BUTTON -->
        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="IMPORTER"
            android:textStyle="bold"
            android:textColor="#6D7CFF"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="30dp"/>

        <!-- VALIDATE BUTTON -->
        <Button
            android:id="@+id/btnValider"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VALIDER"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3DDC97"
            android:layout_marginTop="15dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
